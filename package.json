{
  "name": "@esdecode/license-checker",
  "version": "0.1.2",
  "description": "Deterministic, directional software license compatibility engine with project and source-code acquisition analyzers. Not legal advice.",
  "type": "module",
  "license": "MIT",
  "author": "ESDecode (https://esdecode.com)",
  "homepage": "https://esdecode.com/tools/license-compatibility-checker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esdecode/license-compatibility-checker.git"
  },
  "bugs": {
    "url": "https://github.com/esdecode/license-compatibility-checker/issues"
  },
  "keywords": [
    "license",
    "open-source",
    "license-checker",
    "license-compatibility",
    "spdx",
    "developer-tools",
    "software-licenses",
    "gpl",
    "mit-license",
    "apache-license",
    "saas",
    "source-code"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:exports": "node scripts/verify-exports.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run verify:exports"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
